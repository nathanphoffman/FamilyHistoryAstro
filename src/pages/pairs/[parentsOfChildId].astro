---
import Layout from '../../components/Layout.astro';
import PersonBio from '../../components/render/PersonBio';
import { buildPair, pairChildren } from '../../lib/data';

export async function getStaticPaths() {
  return (await pairChildren()).map((id) => ({ params: { parentsOfChildId: id } }));
}

const { parentsOfChildId } = Astro.params;
const { title, bits, father, mother, candidates, note, union, ctx } = await buildPair(parentsOfChildId!);
---

<Layout title={title}>
  <p class="mx-auto mt-0 mb-[18px] max-w-[820px] text-[.85rem]"><a href="/" class="text-accent">← All charts</a></p>
  <div id="pair" class="mx-auto max-w-[820px]">
    {bits.length > 0 && <div class="mb-[18px] border-b border-b-line px-[30px] pt-0 pb-3.5 text-center text-[.85rem] text-ink-soft">{bits.join(' · ')}</div>}
    <div class="flex items-start gap-6 max-[700px]:block">
      <PersonBio
        person={father}
        ctx={ctx}
        fallbackNote={note}
        candidates={candidates.father}
        shownUnion={union}
      />
      <PersonBio
        person={mother}
        ctx={ctx}
        fallbackNote={note}
        candidates={candidates.mother}
        shownUnion={union}
      />
    </div>
  </div>
</Layout>
