---
import Layout from '../components/Layout.astro';
import { treeCards } from '../lib/data';

const trees = await treeCards();
---

<Layout title="Family History">
  <h1 class="m-0 mb-1 text-center text-[1.9rem]">Family History</h1>
  <p class="m-0 mb-2 text-center text-[.95rem] text-ink-faint">Ancestry charts</p>
  <ul class="mx-auto my-[30px] max-w-[460px] list-none p-0">
    {
      trees.map((t) => (
        <li>
          <a
            href={`/trees/${t.person}.html`}
            class="mb-3 block rounded-[10px] border-2 border-rule bg-card px-[18px] py-3.5 text-inherit no-underline shadow-[2px_2px_6px_var(--shadow)] hover:bg-card-hover"
          >
            {t.relation && <span class="mt-0 mb-[3px] block text-left text-[.72rem] uppercase tracking-[1.6px] text-ink-faint">{t.relation}</span>}
            <span class="text-[1.05rem]">{t.title}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
